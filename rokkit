#!/usr/bin/env bash

# Rokkit - Dotfiles Backup CLI
# A simple tool to manage and backup your dotfiles

set -euo pipefail

# Configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="${SCRIPT_DIR}/config/dotfiles.conf"
DOTFILES_DIR="${SCRIPT_DIR}/dotfiles"

# Load common library
source "${SCRIPT_DIR}/lib/common.sh"

show_help() {
    cat << EOF
Rokkit - Dotfiles Backup CLI

Usage: rokkit <command>

Commands:
    init        Complete system initialization (uninstall, install, restore, and setup scripts)
    backup      Backup dotfiles listed in dotfiles.conf
    restore     Restore dotfiles from backup to your system
    install     Install packages listed in packages.conf using yay
    uninstall   Uninstall packages listed in uninstall-packages.conf using yay
    help        Show this help message

Configuration:
    Edit config/dotfiles.conf to specify which dotfiles to track
    Edit config/packages.conf to specify which packages to install
    Edit config/uninstall-packages.conf to specify which packages to uninstall
    Edit config/drive.conf to configure drive mounting

EOF
}

# Source command files
if [[ ! -f "${SCRIPT_DIR}/commands/backup.sh" ]] || [[ ! -f "${SCRIPT_DIR}/commands/restore.sh" ]] || [[ ! -f "${SCRIPT_DIR}/commands/install.sh" ]] || [[ ! -f "${SCRIPT_DIR}/commands/uninstall.sh" ]] || [[ ! -f "${SCRIPT_DIR}/commands/init.sh" ]]; then
    print_error "Command files missing. Please ensure commands/ directory exists with backup.sh, restore.sh, install.sh, uninstall.sh, and init.sh"
    exit 1
fi

source "${SCRIPT_DIR}/commands/backup.sh"
source "${SCRIPT_DIR}/commands/restore.sh"
source "${SCRIPT_DIR}/commands/install.sh"
source "${SCRIPT_DIR}/commands/uninstall.sh"
source "${SCRIPT_DIR}/commands/init.sh"

# Main script logic
case "${1:-}" in
    init)
        init_system
        ;;
    backup)
        backup_dotfiles
        ;;
    restore)
        restore_dotfiles
        ;;
    install)
        install_packages
        ;;
    uninstall)
        uninstall_packages
        ;;
    help|--help|-h)
        show_help
        ;;
    "")
        show_help
        exit 1
        ;;
    *)
        print_error "Unknown command: $1"
        echo ""
        show_help
        exit 1
        ;;
esac

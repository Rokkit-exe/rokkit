#!/usr/bin/env bash

set -euo pipefail

# Load common library
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${BIN_DIR}/.." && pwd)"
source "${ROOT_DIR}/lib/print.sh"

# Header
print_title "ZSH Environment Setup"

./rokkit-cmd-present zsh || sudo pacman -S --noconfirm --needed zsh || {
    print_error "Failed to install ZSH"
    exit 1
} 

# Get path to ZSH
ZSH_PATH="$(which zsh)"

# Set ZSH as default shell if not already set
chsh -s "$ZSH_PATH" || {
    print_warning "Failed to set ZSH as default shell. You may need to run: chsh -s $ZSH_PATH"
}
print_success "ZSH set as default shell (log out and back in for changes to take effect)"

# Install Oh-My-ZSH
print_info "Installing Oh-My-ZSH..."
./rokkit-install-oh-my-zsh

# Install ZSH plugins
ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"
print_info "Installing ZSH plugins..."
./rokkit-install-zsh-plugins


echo ""
print_success "ZSH setup complete!"
echo ""
print_info "Next steps:"
gum format -- "1. Log out and back in for shell changes to take effect" \
           "2. Open your ~/.zshrc file to customize settings" \
           "3. Restart your terminal or run: source ~/.zshrc"

#!/usr/bin/env bash

set -euo pipefail

# Configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="${SCRIPT_DIR}/../config/drive.conf"

# Load common library
source "${SCRIPT_DIR}/../lib/print.sh"

# ---- Configuration Loading ----

# Check if config file exists
if [[ ! -f "$CONFIG_FILE" ]]; then
    print_error "Configuration file not found: $CONFIG_FILE"
    exit 1
fi

print_info "Loading configuration from: $CONFIG_FILE"

# Parse configuration file
UUID=""
MOUNT_POINT=""
FILESYSTEM=""
MOUNT_OPTIONS="defaults,nofail"
DEVICE_LABEL=""

while IFS='=' read -r key value; do
    # Skip empty lines and comments
    [[ -z "$key" || "$key" =~ ^[[:space:]]*# ]] && continue
    
    # Trim whitespace
    key=$(echo "$key" | xargs)
    value=$(echo "$value" | xargs)
    
    case "$key" in
        UUID)
            UUID="$value"
            ;;
        MOUNT_POINT)
            MOUNT_POINT="$value"
            ;;
        FILESYSTEM)
            FILESYSTEM="$value"
            ;;
        MOUNT_OPTIONS)
            MOUNT_OPTIONS="$value"
            ;;
        DEVICE_LABEL)
            DEVICE_LABEL="$value"
            ;;
    esac
done < "$CONFIG_FILE"

# Validate required fields
if [[ -z "$UUID" ]]; then
    print_error "UUID not specified in configuration file"
    exit 1
fi

if [[ -z "$MOUNT_POINT" ]]; then
    print_error "MOUNT_POINT not specified in configuration file"
    exit 1
fi

if [[ -z "$FILESYSTEM" ]]; then
    print_error "FILESYSTEM not specified in configuration file"
    exit 1
fi

# ---- Display Configuration ----

print_title "Drive Mount Setup"
if [[ -n "$DEVICE_LABEL" ]]; then
    echo "  Drive: $DEVICE_LABEL"
fi
echo "  UUID:       $UUID"
echo "  Mount:      $MOUNT_POINT"
echo "  Filesystem: $FILESYSTEM"
echo "  Options:    $MOUNT_OPTIONS"
echo ""

# ---- Verify Drive Exists ----

print_info "Verifying drive exists..."
DEVICE_PATH=$(blkid -U "$UUID" 2>/dev/null || true)

if [[ -z "$DEVICE_PATH" ]]; then
    print_error "Drive with UUID $UUID not found"
    echo ""
    print_info "Available drives:"
    lsblk -o NAME,UUID,FSTYPE,SIZE,MOUNTPOINT
    exit 1
fi

print_success "Drive found: $DEVICE_PATH"

# ---- Create Mount Point ----

if [[ ! -d "$MOUNT_POINT" ]]; then
    print_info "Creating mount point: $MOUNT_POINT"
    sudo mkdir -p "$MOUNT_POINT" || {
        print_error "Failed to create mount point"
        exit 1
    }
    print_success "Mount point created"
else
    print_success "Mount point exists"
fi

# ---- Check Current Mount Status ----

if mountpoint -q "$MOUNT_POINT"; then
    MOUNTED_UUID=$(findmnt -rno UUID "$MOUNT_POINT" || true)
    
    if [[ "$MOUNTED_UUID" == "$UUID" ]]; then
        print_success "Drive is already mounted at $MOUNT_POINT"
        ALREADY_MOUNTED=true
    else
        print_error "Different drive is mounted at $MOUNT_POINT"
        print_info "Current UUID: $MOUNTED_UUID"
        print_info "Expected UUID: $UUID"
        exit 1
    fi
else
    ALREADY_MOUNTED=false
fi

# ---- Mount Drive ----

if [[ "$ALREADY_MOUNTED" == false ]]; then
    print_info "Mounting drive..."
    
    if sudo mount -t "$FILESYSTEM" -o "$MOUNT_OPTIONS" "UUID=$UUID" "$MOUNT_POINT"; then
        print_success "Drive mounted successfully"
    else
        print_error "Failed to mount drive"
        exit 1
    fi
fi

# ---- Update /etc/fstab ----

FSTAB_ENTRY="UUID=$UUID $MOUNT_POINT   $FILESYSTEM    $MOUNT_OPTIONS  0   2"

if grep -q "UUID=$UUID" /etc/fstab 2>/dev/null; then
    if grep -Fq "$FSTAB_ENTRY" /etc/fstab; then
        print_success "fstab entry is correct"
    else
        print_warning "fstab entry exists but differs"
        print_info "Current:  $(grep "UUID=$UUID" /etc/fstab)"
        print_info "Expected: $FSTAB_ENTRY"
    fi
else
    print_info "Adding drive to /etc/fstab for boot mounting..."
    
    # Backup fstab
    BACKUP_FILE="/etc/fstab.backup.$(date +%s)"
    sudo cp /etc/fstab "$BACKUP_FILE"
    print_success "Created backup: $BACKUP_FILE"
    
    # Add entry
    {
        echo ""
        echo "# $DEVICE_PATH - Added by mount_drive.sh on $(date)"
        echo "$FSTAB_ENTRY"
    } | sudo tee -a /etc/fstab >/dev/null
    
    print_success "Added entry to /etc/fstab"
    
    # Verify fstab
    print_info "Validating fstab..."
    if sudo mount -a --fake 2>/dev/null; then
        print_success "fstab is valid"
        sudo systemctl daemon-reload
        print_success "Systemd reloaded"
    else
        print_error "Invalid fstab configuration!"
        sudo cp "$BACKUP_FILE" /etc/fstab
        print_warning "Restored from backup"
        exit 1
    fi
fi

# ---- Final Status ----

echo ""
print_success "Drive setup complete!"
echo ""
print_info "Mount status:"
df -h "$MOUNT_POINT" | tail -n 1
echo ""

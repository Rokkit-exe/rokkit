#!/bin/bash
# This script installs the 'yay' AUR helper on Arch Linux systems.
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${BIN_DIR}/.." && pwd)"
source "${ROOT_DIR}/lib/print.sh"

# Check if git and base-deve are installed, install them if not

print_title "Installing yay AUR helper"

./rokkit-cmd-present yay && {
  print_success "yay is already installed."
  exit 0
}

if ! pacman -Qe git &>/dev/null && ! pacman -Qe base-devel &>/dev/null; then
  print_info "Installing git and base-devel packages..."
  sudo pacman -S --needed --noconfirm git base-devel
fi

# Clone the yay repository and install it
cd /tmp || exit 1
gum spin --title "Cloning yay repository" -- git clone https://aur.archlinux.org/yay.git
print_info "Cloned yay repository."

if [ -d yay ]; then
  cd yay || {
    print_error "Failed to enter yay directory."
    exit 1
  }
  print_info "Building and installing yay..."
  sudo makepkg -si --noconfirm
  print_success "yay installed successfully."
  cd .. || {
    print_warning "Failed to return to /tmp directory."
    exit 1
  }
  print_info "Cleaning up..."
  rm -rf yay || {
    print_warning "Failed to remove temporary yay directory."
  }
else
  print_error "Failed to clone yay repository."
  exit 1
fi

#!/usr/bin/env bash

set -euo pipefail


# Configuration
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${BIN_DIR}/.." && pwd)"

source "${ROOT_DIR}/lib/common.sh"

WAKE_SCRIPT_SOURCE="${BIN_DIR}/disable_usb_wake.sh"
SERVICE_SOURCE="${ROOT_DIR}/services/disable-usb-wakeup.service"
WAKE_SCRIPT_DEST="/usr/local/bin/disable-usb-wake.sh"
SERVICE_DEST="/etc/systemd/system/disable-usb-wakeup.service"
USB_DEVICES=("XHC0" "XHC1" "XHC2")


print_title "Disable USB Wake Setup\nPrevent keyboard from waking system after suspend"

# ---- Check Source Files ----

print_info "Checking source files..."

if [[ ! -f "$WAKE_SCRIPT_SOURCE" ]]; then
    print_error "Wake script not found: $WAKE_SCRIPT_SOURCE"
    exit 1
fi

if [[ ! -f "$SERVICE_SOURCE" ]]; then
    print_error "Service file not found: $SERVICE_SOURCE"
    exit 1
fi

print_success "Source files found"

# ---- Display Current Wake Status ----

print_info "Current USB wake status:"
echo ""
for device in "${USB_DEVICES[@]}"; do
    if grep -qP "^$device\b" /proc/acpi/wakeup 2>/dev/null; then
        status=$(grep -P "^$device\b" /proc/acpi/wakeup | awk '{print $3}')
        if [[ "$status" == "*enabled" ]]; then
            echo -e "  ${device}: ${RED}enabled${NC} (will wake system)"
        else
            echo -e "  ${device}: ${GREEN}disabled${NC} (won't wake system)"
        fi
    else
        echo -e "  ${device}: ${YELLOW}not found${NC}"
    fi
done
echo ""

# ---- Install Wake Script ----

if [[ -f "$WAKE_SCRIPT_DEST" ]]; then
    print_success "Wake script already installed at $WAKE_SCRIPT_DEST"
else
    print_info "Installing wake script to $WAKE_SCRIPT_DEST..."
    sudo cp "$WAKE_SCRIPT_SOURCE" "$WAKE_SCRIPT_DEST" || {
        print_error "Failed to copy wake script"
        exit 1
    }
    sudo chmod 755 "$WAKE_SCRIPT_DEST" || {
        print_error "Failed to set script permissions"
        exit 1
    }
    print_success "Wake script installed"
fi

# ---- Install Systemd Service ----

if [[ -f "$SERVICE_DEST" ]]; then
    print_success "Systemd service already installed at $SERVICE_DEST"
else
    print_info "Installing systemd service to $SERVICE_DEST..."
    sudo cp "$SERVICE_SOURCE" "$SERVICE_DEST" || {
        print_error "Failed to copy service file"
        exit 1
    }
    sudo chmod 644 "$SERVICE_DEST" || {
        print_error "Failed to set service permissions"
        exit 1
    }
    print_success "Systemd service installed"
fi

# ---- Enable and Start Service ----

print_info "Configuring systemd service..."

if systemctl is-enabled disable-usb-wakeup.service &>/dev/null; then
    print_success "Service is already enabled"
else
    print_info "Enabling service..."
    sudo systemctl enable disable-usb-wakeup.service || {
        print_error "Failed to enable service"
        exit 1
    }
    print_success "Service enabled"
fi

if systemctl is-active disable-usb-wakeup.service &>/dev/null; then
    print_success "Service is already running"
else
    print_info "Starting service..."
    sudo systemctl start disable-usb-wakeup.service || {
        print_error "Failed to start service"
        exit 1
    }
    print_success "Service started"
fi

# ---- Reload Systemd ----

print_info "Reloading systemd daemon..."
sudo systemctl daemon-reload
print_success "Systemd daemon reloaded"

# ---- Display Final Wake Status ----

echo ""
print_info "Final USB wake status:"
echo ""
for device in "${USB_DEVICES[@]}"; do
    if grep -qP "^$device\b" /proc/acpi/wakeup 2>/dev/null; then
        status=$(grep -P "^$device\b" /proc/acpi/wakeup | awk '{print $3}')
        if [[ "$status" == "*enabled" ]]; then
            echo -e "  ${device}: ${RED}enabled${NC} (will wake system)"
        else
            echo -e "  ${device}: ${GREEN}disabled${NC} (won't wake system)"
        fi
    else
        echo -e "  ${device}: ${YELLOW}not found${NC}"
    fi
done
echo ""

# ---- Final Status ----

print_title "USB wake setup complete!"
echo ""
print_info "The service will run automatically on boot"
print_info "To check service status: systemctl status disable-usb-wakeup.service"
print_info "To manually run: sudo systemctl start disable-usb-wakeup.service"
echo ""

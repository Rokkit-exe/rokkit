#!/usr/bin/env bash
set -euo pipefail

# ---- Helpers ---------------------------------------------------------------
msg(){ printf "\n\033[1;32m==> %s\033[0m\n" "$*"; }
err(){ printf "\n\033[1;31m==> %s\033[0m\n" "$*"; exit 1; }
need_cmd(){ command -v "$1" >/dev/null 2>&1 || err "Missing '$1' in PATH"; }
separator(){ echo "----------------------------------------------------------------------"; }

# ---- Usage -----------------------------------------------------------------
show_usage() {
  cat <<EOF
Install Android Tools - Setup Android AVD with selected API level

USAGE:
  $0 [OPTIONS]

OPTIONS:
  -h, --help      Show this help message

DESCRIPTION:
  Interactive script to install or remove Android Virtual Devices (AVDs).
  You will be prompted to:
    - Choose install or remove action
    - Select Android API level (30-36)
    - Select device profile (pixel_6, pixel_7, pixel_8, pixel_9, resizable, small_phone)
    - Configure GPU rendering (SwiftShader)

REQUIREMENTS:
  - sdkmanager and avdmanager in PATH
  - Android SDK root at: \$ANDROID_SDK_ROOT or \$HOME/android/Sdk

EOF
}

# ---- Parse arguments -------------------------------------------------------
for arg in "$@"; do
  case "$arg" in
    -h|--help)
      show_usage
      exit 0
      ;;
  esac
done

# puts each AVD name into an array element
readarray -t EMULATORS < <(emulator -list-avds 2>/dev/null || echo "")


CHOICE=("install" "remove")
separator 
echo "Select action:"
select action in "${CHOICE[@]}"; do
  if [[ " ${CHOICE[*]} " == *" $action "* ]]; then
    ACTION="$action"
    break
  else
    echo "Invalid selection. Please try again."
  fi
done

if [[ "$ACTION" == "remove" ]]; then
  if [ "${#EMULATORS[@]}" -eq 0 ]; then
    err "No AVDs found to remove."
  fi
  # seperator
  echo "Select AVD to remove:"
  select avd in "${EMULATORS[@]}"; do
    if [[ " ${EMULATORS[*]} " == *" $avd "* ]]; then
      AVD_NAME="$avd"
      break
    else
      echo "Invalid selection. Please try again."
    fi
  done

  msg "Removing AVD '${AVD_NAME}' ..."
  avdmanager delete avd -n "$AVD_NAME" || err "Failed to remove AVD '${AVD_NAME}'."
  msg "AVD '${AVD_NAME}' removed successfully."
  exit 0
fi

API_LEVELS=("30" "31" "32" "33" "34" "35" "36")
# seperator
echo "Select Android API level to install:"
select api in "${API_LEVELS[@]}"; do
  if [[ " ${API_LEVELS[*]} " == *" $api "* ]]; then
    API_LEVEL="$api"
    break
  else
    echo "Invalid selection. Please try again."
  fi
done

DEVICE_PROFILES=("pixel_6" "pixel_7" "pixel_8" "pixel_9" "resizable" "small_phone")
# seperator
echo "Select device profile for AVD:"
select device in "${DEVICE_PROFILES[@]}"; do
  if [[ " ${DEVICE_PROFILES[*]} " == *" $device "* ]]; then
    DEVICE_PROFILE="$device"
    break
  else
    echo "Invalid selection. Please try again."
  fi
done

# === Config (bump API if you know it's available) ===
IMAGE_KEY="system-images;android-${API_LEVEL};google_apis;x86_64"
DEVICE_PROFILE="${DEVICE_PROFILE:-resizable}"   # run: avdmanager list device
AVD_NAME="${AVD_NAME:-${DEVICE_PROFILE}_API_${API_LEVEL}}"
INI="$HOME/.android/avd/${AVD_NAME}.avd/config.ini"

# SDK root: respect existing, else default to HOME
export ANDROID_SDK_ROOT="${ANDROID_SDK_ROOT:-$HOME/android/Sdk}"
export ANDROID_HOME="$ANDROID_SDK_ROOT"

# Put sdkmanager/avdmanager/emulator in PATH
export PATH="$ANDROID_SDK_ROOT/cmdline-tools/latest/bin:$ANDROID_SDK_ROOT/platform-tools:$ANDROID_SDK_ROOT/emulator:$PATH"




# Re-check now that PATH includes cmdline-tools
need_cmd sdkmanager
need_cmd avdmanager

# Accept licenses up front
msg "Accepting Android SDK licenses..."
yes | sdkmanager --sdk_root="$ANDROID_SDK_ROOT" --licenses >/dev/null || true


msg "Installing platform-tools, platform ${API_LEVEL}, and system image into HOME SDK ..."
sdkmanager --sdk_root="$ANDROID_SDK_ROOT" --install "platform-tools" "platforms;android-${API_LEVEL}" "$IMAGE_KEY"

# Create AVD (clean if it exists)
msg "Creating AVD '${AVD_NAME}' with device '${DEVICE_PROFILE}' ..."
avdmanager delete avd -n "$AVD_NAME" || true

# Non-interactive; let -k decide tag/ABI (no need to pass --abi/--tag)
echo "no" | avdmanager create avd \
  -n "$AVD_NAME" \
  -k "$IMAGE_KEY" \
  --device "$DEVICE_PROFILE" \
  --sdcard "2048M" \
  --force

# Verify
need_cmd emulator
msg "Available AVDs:"
emulator -list-avds || true 


# backup
# ask the user if they want to use GPU rendering with SwiftShader
GPU_CHOICES=("yes" "no")
# separator
echo "Do you want to enable GPU rendering with SwiftShader for the AVD?"
select gpu_choice in "${GPU_CHOICES[@]}"; do
  if [[ " ${GPU_CHOICES[*]} " == *" $gpu_choice "* ]]; then
    GPU_CHOICE="$gpu_choice"
    break
  else
    echo "Invalid selection. Please try again."
  fi
done

if [[ "$GPU_CHOICE" == "yes" ]]; then
  msg "Patching AVD config to use SwiftShader GPU rendering ..."
  cp -f "$INI" "${INI}.bak"

  # ensure GPU is on and forced to swiftshader
  grep -q '^hw.gpu.enabled=' "$INI" && \
    sed -i 's/^hw.gpu.enabled=.*/hw.gpu.enabled=yes/' "$INI" || \
    printf '\nhw.gpu.enabled=yes\n' >> "$INI"

  # set mode to swiftshader_indirect
  if grep -q '^hw.gpu.mode=' "$INI"; then
    sed -i 's/^hw.gpu.mode=.*/hw.gpu.mode=swiftshader_indirect/' "$INI"
  else
    printf 'hw.gpu.mode=swiftshader_indirect\n' >> "$INI"
  fi
  msg "AVD config patched successfully."
else
  msg "Skipping GPU rendering configuration."
fi

msg "Enabling keyboard support"
grep -q '^hw.keyboard=' "$INI" && \
  sed -i 's/^hw.keyboard=.*/hw.keyboard=yes/' "$INI" || \
  printf '\nhw.keyboard=yes\n' >> "$INI" 

cat <<EOF

----------------------------------------------------------------------
✅ Setup complete.

AVD:
  Name: ${AVD_NAME}
  Image: ${IMAGE_KEY}
  Device profile: ${DEVICE_PROFILE}

Useful:
  flutter doctor -v
  avdmanager list device
  sdkmanager --sdk_root="\$ANDROID_SDK_ROOT" --list

----------------------------------------------------------------------
EOF



#!/bin/bash

# Check if VM name was provided
if [ -z "$1" ]; then
    echo "Usage: $0 <vm_name> - Shutdown, destroy, and undefine VM (disk preserved)"
    exit 1
fi

vm_name=$1

echo "Shutting down VM: $vm_name"
sudo virsh --connect qemu:///system shutdown "$vm_name" 2>/dev/null || true
sleep 5

echo "Forcing VM off..."
sudo virsh --connect qemu:///system destroy "$vm_name" 2>/dev/null || true
sleep 2

echo "Undefining VM (disk preserved)..."
sudo virsh --connect qemu:///system undefine "$vm_name" --nvram || { echo "Failed to undefine VM"; exit 1; }

echo "VM removed - disk at /mnt/storage/${vm_name}.qcow2 is ready for reuse"
